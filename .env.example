# Copy to .env to run the app, worker, mock bank or Alembic from the host (outside Docker).
# Never commit .env. Docker Compose sets these itself; see docker-compose.yml.

# local | test | production. Production requires ADMIN_TOKEN and BANK_CALLBACK_SECRET.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379/0

# Protects POST /v1/merchants (sent as X-Admin-Token). At least 16 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=

PAYMENT_TTL_MINUTES=15
# Requests per API key per minute, counted in Redis.
RATE_LIMIT_PER_MINUTE=100
# Let webhook URLs point at private or loopback addresses, e.g. a receiver on this machine.
# Local development only: refused when ENVIRONMENT=production.
# WEBHOOK_ALLOW_PRIVATE_URLS=true
LOG_LEVEL=INFO
# json for machines, console for humans
LOG_FORMAT=console

# --- Bank ---------------------------------------------------------------------
# The bank signs its callbacks with this secret, and the gateway rejects every callback while
# it is unset. Shared by the gateway and the mock bank. At least 16 characters.
BANK_CALLBACK_SECRET=change-me-dev-bank-secret
# Where the worker submits payments.
BANK_URL=http://localhost:8001

# Mock bank only (mock_bank/main.py). Rates are fractions from 0 to 1.
BANK_CALLBACK_URL=http://localhost:8000/internal/bank/callback
BANK_FAILURE_RATE=0.1
BANK_DUPLICATE_RATE=0.1
# Submissions the bank accepts but answers with 503, so the worker must retry safely.
BANK_LOST_RESPONSE_RATE=0.0
BANK_MIN_DELAY_SECONDS=0.5
BANK_MAX_DELAY_SECONDS=3
