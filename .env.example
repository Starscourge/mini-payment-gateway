# Copy to .env to run the app or Alembic from the host (outside Docker). Never commit .env.
# Docker Compose sets these itself; see docker-compose.yml.

# local | test | production. Production requires ADMIN_TOKEN.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379/0

# Protects POST /v1/merchants (sent as X-Admin-Token). At least 16 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=

PAYMENT_TTL_MINUTES=15
LOG_LEVEL=INFO
# json for machines, console for humans
LOG_FORMAT=console
